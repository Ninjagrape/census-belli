# Copy to .env and fill in. .env is gitignored; never commit real values.

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/general_war

# ─── LLM providers ───────────────────────────────────────────────────────────
# Every LLM stage defaults to llm_mode: offline (agents/<stage>.yaml): uncached
# requests go to data/llm_requests/ and are answered by /process-llm-batch in
# Claude Code, on the subscription's usage limits. No key is needed for that.

# Anthropic. Only needed for a stage switched to llm_mode: api, which sends the
# same requests to the API and shares the llm_calls cache with offline answers.
# Key from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
