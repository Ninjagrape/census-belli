# Copy to .env and fill in. .env is gitignored; never commit real values.

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/general_war

# ─── LLM providers ───────────────────────────────────────────────────────────
# Which provider serves which stage is set per stage in agents/<stage>.yaml
# under params.llm_provider. Only the providers actually referenced there
# need a key.

# Anthropic. Used by the classify stage, where command attribution is the
# judgement the whole methodology rests on.
# Key from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Google Gemini. The workhorse for the high-volume extract and resolve
# stages. This must be an AI Studio API key (starts with AIza), not an OAuth
# token from gcloud or the Gemini CLI, and not a Google AI Pro subscription,
# which covers the consumer app rather than programmatic access.
# Key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
